@@ -1458,7 +1462,10 @@ LRESULT CALLBACK search_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp) {
             default: break;
         }
     }
-    return CallWindowProcW(gOldSearchProc, hwnd, msg, wp, lp);
