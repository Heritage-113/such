             layout_children(hwnd);
             SetFocus(gSearch);
             return 0;
@@ -1890,7 +1900,8 @@ int WINAPI wWinMain(HINSTANCE instance, HINSTANCE, PWSTR, int show) {
         gRuntimeIndexedFiles = status.indexed_files;
